[Desktop Entry]
Type=Application
Name=Mass
GenericName=Music Player
Comment=Music Assistant player with matugen theming
Exec=mass
Icon=io.github.mass_matugen.Mass
Terminal=false
Categories=AudioVideo;Audio;Player;GTK;
Keywords=music;assistant;player;sendspin;mpris;
StartupNotify=true
DBusActivatable=false
SingleMainWindow=true
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play/Pause
Exec=mass --play-pause

[Desktop Action Next]
Name=Next Track
Exec=mass --next

[Desktop Action Previous]
Name=Previous Track
Exec=mass --previous
