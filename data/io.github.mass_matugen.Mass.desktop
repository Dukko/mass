[Desktop Entry]
Type=Application
Name=Mass
GenericName=Music Player
Comment=Music Assistant player with matugen theming
Exec=mass %U
Icon=io.github.mass_matugen.Mass
Terminal=false
Categories=AudioVideo;Audio;Player;GTK;
Keywords=music;assistant;player;sendspin;mpris;
StartupNotify=true
DBusActivatable=false
SingleMainWindow=true
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play/Pause
Exec=gapplication action io.github.mass_matugen.Mass play-pause

[Desktop Action Next]
Name=Next Track
Exec=gapplication action io.github.mass_matugen.Mass next

[Desktop Action Previous]
Name=Previous Track
Exec=gapplication action io.github.mass_matugen.Mass previous
